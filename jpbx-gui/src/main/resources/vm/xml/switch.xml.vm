<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<document type="freeswitch/xml">
  <section name="configuration" description="Various Configuration">
    <configuration name="switch.conf" description="Core Configuration">
      <cli-keybindings>
        <key name="1" value="help"/>
        <key name="2" value="status"/>
        <key name="3" value="show channels"/>
        <key name="4" value="show calls"/>
        <key name="5" value="sofia status"/>
        <key name="6" value="reloadxml"/>
        <key name="7" value="console loglevel 0"/>
        <key name="8" value="console loglevel 7"/>
        <key name="9" value="sofia status profile internal"/>
        <key name="10" value="sofia profile internal siptrace on"/>
        <key name="11" value="sofia profile internal siptrace off"/>
        <key name="12" value="version"/>
      </cli-keybindings>
      <settings>
        #if($params && $params.get('colorize-console') && $params.get('colorize-console') != '')
        <param name="colorize-console" value="$params.get('colorize-console')"/>
        #else
        <param name="colorize-console" value="true"/>
        #end
        <param name="dialplan-timestamps" value="false"/>
        <param name="max-db-handles" value="50"/>
        <param name="db-handle-timeout" value="10"/>
        #if($params && $params.get('max-sessions') && $params.get('max-sessions') != '')
        <param name="max-sessions" value="$params.get('max-sessions')"/>
        #else
        <param name="max-sessions" value="1000"/>
        #end
        #if($params && $params.get('sessions-per-second') && $params.get('sessions-per-second') != '')
        <param name="sessions-per-second" value="$params.get('sessions-per-second')"/>
        #else
        <param name="sessions-per-second" value="30"/>
        #end
        #if($params && $params.get('loglevel') && $params.get('loglevel') != '')
        <param name="loglevel" value="$params.get('loglevel')"/>
        #else
        <param name="loglevel" value="info"/>
        #end
        <param name="mailer-app" value="sendmail"/>
        <param name="mailer-app-args" value="-t"/>
        <param name="dump-cores" value="yes"/>
        #if($params && $params.get('rtp-start-port') && $params.get('rtp-start-port') != '')
        <param name="rtp-start-port" value="$params.get('rtp-start-port')"/>
        #elseif($sysconf.startRtpPort && $sysconf.startRtpPort != '')
        <param name="rtp-start-port" value="${sysconf.startRtpPort}"/>
        #end
        #if($params && $params.get('rtp-end-port') && $params.get('rtp-end-port') != '')
        <param name="rtp-end-port" value="$params.get('rtp-end-port')"/>
        #elseif($sysconf.endRtpPort && $sysconf.endRtpPort != '')
        <param name="rtp-end-port" value="${sysconf.endRtpPort}"/>
        #end
      </settings>
    </configuration>
  </section>
</document>
