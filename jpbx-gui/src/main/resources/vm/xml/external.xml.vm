<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<document type="freeswitch/xml">
  <section name="configuration" description="Various Configuration">
  <configuration name="sofia.conf" description="sofia Endpoint">
    <profiles>
      <profile name="external">
        <gateways>
          #foreach($gateway in $gateways)
            <gateway name="$xml.escape($gateway.id)">
              <param name="realm" value="$xml.escape($gateway.realm)"/>
              #if($gateway.register == 0)
                <param name="register" value="false"/>
              #else
                <param name="register" value="true"/>
                <param name="username" value="$xml.escape($gateway.username)"/>
                <param name="password" value="$xml.escape($gateway.password)"/>
              #end
              <param name="register-transport" value="$xml.escape($gateway.transport)"/>
              <param name="retry-seconds" value="$xml.escape($gateway.retrySeconds)"/>
              <param name="ping" value="25"/>
            </gateway>
          #end
        </gateways>
        <aliases>
        </aliases>
        <domains>
          <domain name="all" alias="false" parse="true"/>
        </domains>
        <settings>
          <param name="debug" value="0"/>
          <param name="sip-trace" value="no"/>
          <param name="sip-capture" value="no"/>
          <param name="rfc2833-pt" value="101"/>
          #if($params && $params.get('sip-port') && $params.get('sip-port') != '')
          <param name="sip-port" value="$params.get('sip-port')"/>
          #elseif($sysconf.externalPort && $sysconf.externalPort != '')
          <param name="sip-port" value="${sysconf.externalPort}"/>
          #else
          <param name="sip-port" value="$${external_sip_port}"/>
          #end
          <param name="dialplan" value="XML"/>
          #if($params && $params.get('context') && $params.get('context') != '')
          <param name="context" value="$params.get('context')"/>
          #else
          <param name="context" value="public"/>
          #end
          <param name="dtmf-duration" value="2000"/>
          #if($params && $params.get('inbound-codec-prefs') && $params.get('inbound-codec-prefs') != '')
          <param name="inbound-codec-prefs" value="$params.get('inbound-codec-prefs')"/>
          <param name="outbound-codec-prefs" value="$params.get('outbound-codec-prefs')"/>
          #elseif($sysconf.audioCode && $sysconf.audioCode != '')
          <param name="inbound-codec-prefs" value="${sysconf.audioCode},#if($sysconf.videoCode)${sysconf.videoCode}#end"/>
          <param name="outbound-codec-prefs" value="${sysconf.audioCode},#if($sysconf.videoCode)${sysconf.videoCode}#end"/>
          #else
          <param name="inbound-codec-prefs" value="$${global_codec_prefs}"/>
          <param name="outbound-codec-prefs" value="$${outbound_codec_prefs}"/>
          #end
          <param name="hold-music" value="$${hold_music}"/>
          <param name="rtp-timer-name" value="soft"/>
          <param name="local-network-acl" value="localnet.auto"/>
          <param name="manage-presence" value="false"/>
          <param name="inbound-codec-negotiation" value="generous"/>
          <param name="nonce-ttl" value="60"/>
          #if($params && $params.get('auth-calls') && $params.get('auth-calls') != '')
          <param name="auth-calls" value="$params.get('auth-calls')"/>
          #else
          <param name="auth-calls" value="false"/>
          #end
          <param name="inbound-late-negotiation" value="true"/>
          #if($params && $params.get('accept-blind-reg') && $params.get('accept-blind-reg') != '')
          <param name="accept-blind-reg" value="$params.get('accept-blind-reg')"/>
          #else
          <param name="accept-blind-reg" value="false"/>
          #end
          #if($params && $params.get('apply-inbound-acl') && $params.get('apply-inbound-acl') != '')
          <param name="apply-inbound-acl" value="$params.get('apply-inbound-acl')"/>
          #end
          #if($params && $params.get('sip-ip') && $params.get('sip-ip') != '')
          <param name="sip-ip" value="$params.get('sip-ip')"/>
          <param name="rtp-ip" value="#if($params.get('rtp-ip') && $params.get('rtp-ip') != '')$params.get('rtp-ip')#{else}$params.get('sip-ip')#end"/>
          #elseif($sysconf.remoteIp && $sysconf.remoteIp != '')
          <param name="rtp-ip" value="${sysconf.remoteIp}"/>
          <param name="sip-ip" value="${sysconf.remoteIp}"/>
          #else
          <param name="rtp-ip" value="$${local_ip_v4}"/>
          <param name="sip-ip" value="$${local_ip_v4}"/>
          #end
          #if($params && $params.get('ext-sip-ip') && $params.get('ext-sip-ip') != '')
          <param name="ext-sip-ip" value="$params.get('ext-sip-ip')"/>
          <param name="ext-rtp-ip" value="#if($params.get('ext-rtp-ip') && $params.get('ext-rtp-ip') != '')$params.get('ext-rtp-ip')#{else}$params.get('ext-sip-ip')#end"/>
          #elseif($sysconf.iceStart)
          <param name="ext-rtp-ip" value="${sysconf.stunAddress}"/>
          <param name="ext-sip-ip" value="${sysconf.stunAddress}"/>
          #else
          <param name="ext-rtp-ip" value="$${external_rtp_ip}"/>
          <param name="ext-sip-ip" value="$${external_sip_ip}"/>
          #end
          #if($params && $params.get('rtp-timeout-sec') && $params.get('rtp-timeout-sec') != '')
          <param name="rtp-timeout-sec" value="$params.get('rtp-timeout-sec')"/>
          #else
          <param name="rtp-timeout-sec" value="300"/>
          #end
          <param name="rtp-hold-timeout-sec" value="1800"/>
          <param name="tls" value="$${external_ssl_enable}"/>
          <param name="tls-only" value="false"/>
          <param name="tls-bind-params" value="transport=tls"/>
          <param name="tls-sip-port" value="$${external_tls_port}"/>
          <param name="tls-passphrase" value=""/>
          <param name="tls-verify-date" value="true"/>
          <param name="tls-verify-policy" value="none"/>
          <param name="tls-verify-depth" value="2"/>
          <param name="tls-verify-in-subjects" value=""/>
          <param name="tls-version" value="$${sip_tls_version}"/>
          <param name="tls-ciphers" value="$${sip_tls_ciphers}"/>
        </settings>
      </profile>
    </profiles>
    </configuration>
  </section>
</document>