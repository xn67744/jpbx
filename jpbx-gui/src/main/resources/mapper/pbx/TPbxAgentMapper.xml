            <if test="busyDelayTime != null and busyDelayTime != ''">AND busy_delay_time = #{busyDelayTime}</if>
            <if test="enabled != null and enabled != ''">AND enabled = #{enabled}</if>
            <if test="remark != null and remark != ''">AND remark = #{remark}</if>
        </where>
        order by 1
    </select>
    <select id="selectTPbxAgentById" parameterType="String" resultMap="TPbxAgentResult">
