    <sql id="selectVo">select id, name, contact, status, type, max_no_answer, wrap_up_time, reject_delay_time, busy_delay_time, enabled, remark from t_pbx_agent</sql>
    <select id="selectTPbxAgentList" parameterType="TPbxAgent" resultMap="TPbxAgentResult">
        <include refid="selectVo"/>
        <where>
            <if test="id != null and id != ''">AND id = #{id}</if>
            <if test="name != null and name != ''">AND name = #{name}</if>
            <if test="contact != null and contact != ''">AND contact = #{contact}</if>
            <if test="status != null and status != ''">AND status = #{status}</if>
