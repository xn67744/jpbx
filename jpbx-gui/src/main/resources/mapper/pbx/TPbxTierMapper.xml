    <insert id="insertTPbxTier" parameterType="TPbxTier">
        insert into t_pbx_tier
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="queueName != null">queue_name,</if>
            <if test="agentName != null">agent_name,</if>
            <if test="level != null">level,</if>
            <if test="position != null">position,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="queueName != null">#{queueName},</if>
            <if test="agentName != null">#{agentName},</if>
            <if test="level != null">#{level},</if>
            <if test="position != null">#{position},</if>
        </trim>
    </insert>
    <update id="updateTPbxTier" parameterType="TPbxTier">
        update t_pbx_tier
