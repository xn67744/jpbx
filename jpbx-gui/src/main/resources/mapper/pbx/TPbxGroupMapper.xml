<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.av.jpbx.mapper.TPbxGroupMapper">
    <resultMap type="TPbxGroup" id="TPbxGroupResult">
        <result property="id" column="id" />
        <result property="name" column="name" />
        <result property="domain" column="domain" />
        <result property="remark" column="remark" />
    </resultMap>
    <sql id="selectVo">select id, name, domain, remark from t_pbx_group</sql>
    <select id="selectTPbxGroupList" parameterType="TPbxGroup" resultMap="TPbxGroupResult">
        <include refid="selectVo"/>
        <where>
            <if test="id != null and id != ''">AND id = #{id}</if>
            <if test="name != null and name != ''">AND name = #{name}</if>
            <if test="domain != null and domain != ''">AND domain = #{domain}</if>
            <if test="remark != null and remark != ''">AND remark = #{remark}</if>
        </where>
        order by 1
    </select>
    <select id="selectTPbxGroupById" parameterType="String" resultMap="TPbxGroupResult">
        <include refid="selectVo"/> where id = #{id}
    </select>
    <insert id="insertTPbxGroup" parameterType="TPbxGroup">
        insert into t_pbx_group
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="name != null">name,</if>
            <if test="domain != null">domain,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="name != null">#{name},</if>
            <if test="domain != null">#{domain},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>
    <update id="updateTPbxGroup" parameterType="TPbxGroup">
        update t_pbx_group
        <trim prefix="SET" suffixOverrides=",">
            <if test="name != null">name = #{name},</if>
            <if test="domain != null">domain = #{domain},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>
    <delete id="deleteTPbxGroupById" parameterType="String">delete from t_pbx_group where id = #{id}</delete>
    <delete id="deleteTPbxGroupByIds" parameterType="String">
        delete from t_pbx_group where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">#{id}</foreach>
    </delete>
</mapper>