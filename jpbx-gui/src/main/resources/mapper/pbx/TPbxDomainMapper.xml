<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.av.jpbx.mapper.TPbxDomainMapper">
    <resultMap type="TPbxDomain" id="TPbxDomainResult">
        <result property="id" column="id" />
        <result property="name" column="name" />
        <result property="parse" column="parse" />
        <result property="alias" column="alias" />
        <result property="enabled" column="enabled" />
        <result property="remark" column="remark" />
    </resultMap>
    <sql id="selectVo">select id, name, parse, alias, enabled, remark from t_pbx_domain</sql>
    <select id="selectTPbxDomainList" parameterType="TPbxDomain" resultMap="TPbxDomainResult">
        <include refid="selectVo"/>
        <where>
            <if test="id != null and id != ''">AND id = #{id}</if>
            <if test="name != null and name != ''">AND name = #{name}</if>
            <if test="parse != null and parse != ''">AND parse = #{parse}</if>
            <if test="alias != null and alias != ''">AND alias = #{alias}</if>
            <if test="enabled != null and enabled != ''">AND enabled = #{enabled}</if>
            <if test="remark != null and remark != ''">AND remark = #{remark}</if>
        </where>
        order by 1
    </select>
    <select id="selectTPbxDomainById" parameterType="String" resultMap="TPbxDomainResult">
        <include refid="selectVo"/> where id = #{id}
    </select>
    <insert id="insertTPbxDomain" parameterType="TPbxDomain">
        insert into t_pbx_domain
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="name != null">name,</if>
            <if test="parse != null">parse,</if>
            <if test="alias != null">alias,</if>
            <if test="enabled != null">enabled,</if>
            <if test="remark != null">remark,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="name != null">#{name},</if>
            <if test="parse != null">#{parse},</if>
            <if test="alias != null">#{alias},</if>
            <if test="enabled != null">#{enabled},</if>
            <if test="remark != null">#{remark},</if>
        </trim>
    </insert>
    <update id="updateTPbxDomain" parameterType="TPbxDomain">
        update t_pbx_domain
        <trim prefix="SET" suffixOverrides=",">
            <if test="name != null">name = #{name},</if>
            <if test="parse != null">parse = #{parse},</if>
            <if test="alias != null">alias = #{alias},</if>
            <if test="enabled != null">enabled = #{enabled},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where id = #{id}
    </update>
    <delete id="deleteTPbxDomainById" parameterType="String">delete from t_pbx_domain where id = #{id}</delete>
    <delete id="deleteTPbxDomainByIds" parameterType="String">
        delete from t_pbx_domain where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">#{id}</foreach>
    </delete>
</mapper>